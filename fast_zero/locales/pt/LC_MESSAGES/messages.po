# Route summaries and descriptions
msgid "Get greeting"
msgstr "Obter saudação"

msgid "Returns a simple greeting message."
msgstr "Retorna uma mensagem de saudação simples."

msgid "Get HTML greeting"
msgstr "Obter saudação em HTML"

msgid "Returns an HTML page with a greeting"
msgstr "Retorna uma página HTML com uma saudação"

msgid "Create user"
msgstr "Criar usuário"

msgid "Creates a new user and returns the public user representation."
msgstr "Cria um novo usuário e retorna sua representação pública."

msgid "List users"
msgstr "Listar usuários"

msgid "Returns a list of users (paginated)."
msgstr "Retorna uma lista de usuários (paginada)."

msgid "Number of items to skip"
msgstr "Número de itens a pular"

msgid "Max number of items to return"
msgstr "Número máximo de itens a retornar"

msgid "Get user"
msgstr "Obter usuário"

msgid "Return a single user by ID."
msgstr "Retorna um único usuário por ID."

msgid "User ID"
msgstr "ID do usuário"

msgid "Update user"
msgstr "Atualizar usuário"

msgid "Update a user by ID and return the updated user."
msgstr "Atualiza um usuário por ID e retorna o usuário atualizado."

msgid "Delete user"
msgstr "Remover usuário"

msgid "Delete a user by ID and return a confirmation message."
msgstr "Remove um usuário por ID e retorna uma mensagem de confirmação."

msgid "Conflict"
msgstr "Conflito"

msgid "Not found"
msgstr "Não encontrado"

msgid "Successful deletion"
msgstr "Remoção bem-sucedida"
